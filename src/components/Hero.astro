---
import { profile } from "@/data/profile";

const actions = [
  { href: profile.github, label: "GitHub", external: true, primary: true },
  { href: profile.linkedin, label: "LinkedIn", external: true, primary: false },
  { href: "/resume", label: "Resume", external: false, primary: false },
];
---

<section id="top" class="px-5 pt-16 pb-12 sm:pt-24 sm:pb-16">
  <div class="mx-auto max-w-3xl">
    <p class="text-sm text-muted-foreground">{profile.role} · {profile.location}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{profile.name}</h1>
    <p class="mt-5 max-w-xl text-base leading-7 text-muted-foreground">{profile.summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {
        actions.map((action) => (
          <a
            href={action.href}
            target={action.external ? "_blank" : undefined}
            rel={action.external ? "noopener noreferrer" : undefined}
            class:list={[
              "inline-flex h-10 items-center justify-center rounded-md px-4 text-sm font-medium",
              action.primary
                ? "bg-primary text-primary-foreground"
                : "border hover:bg-accent",
            ]}
          >
            {action.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
