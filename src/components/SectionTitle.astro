---
interface Props {
  kicker: string;
  title: string;
}

const { kicker, title } = Astro.props;
---

<div data-reveal class="border-b pb-4">
  <p class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{kicker}</p>
  <h2 class="mt-1 text-2xl font-semibold tracking-tight">{title}</h2>
</div>
