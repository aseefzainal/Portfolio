---
import { profile } from "@/data/profile";
import SectionTitle from "@/components/SectionTitle.astro";

const items = profile.timeline.filter((item) => item.kind === "Work");
---

<section id="experience" class="px-5 py-12 sm:py-16">
  <div class="mx-auto max-w-3xl">
    <SectionTitle kicker="Career" title="Experience" />
    <ol class="mt-2">
      {
        items.map((item) => (
          <li data-reveal class="grid gap-1 border-b py-6 sm:grid-cols-[10.5rem_1fr] sm:gap-8">
            <p class="text-sm text-muted-foreground">{item.period}</p>
            <div>
              <h3 class="font-medium">{item.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{item.place}</p>
              <p class="mt-2 text-sm leading-6">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
