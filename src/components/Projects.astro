---
import { profile } from "@/data/profile";
import SectionTitle from "@/components/SectionTitle.astro";
---

<section id="projects" class="px-5 py-12 sm:py-16">
  <div class="mx-auto max-w-3xl">
    <SectionTitle kicker="Selected work" title="Projects" />
    <ul class="mt-2">
      {
        profile.projects.map((project) => (
          <li data-reveal class="flex gap-4 border-b py-6">
            {project.image ? (
              <div class="flex size-14 shrink-0 items-center justify-center rounded-md border bg-white p-1.5">
                <img src={project.image} alt="" class="max-h-full max-w-full object-contain" />
              </div>
            ) : null}
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-medium">{project.title}</h3>
                <p class="text-xs text-muted-foreground">{project.stack.join(" · ")}</p>
              </div>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">{project.description}</p>
              {project.href || project.repo ? (
                <div class="mt-3 flex gap-4 text-sm font-medium">
                  {project.href ? (
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline underline-offset-4"
                    >
                      Live
                    </a>
                  ) : null}
                  {project.repo ? (
                    <a
                      href={project.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline underline-offset-4"
                    >
                      Repo
                    </a>
                  ) : null}
                </div>
              ) : null}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
